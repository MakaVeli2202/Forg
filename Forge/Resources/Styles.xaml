<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NavButtonStyle"
           TargetType="Button">

        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Foreground" Value="#E5E7EB"/>
        <Setter Property="Background" Value="#23272D"/>
        <Setter Property="BorderBrush" Value="#343A42"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#4A515B"/>
                            <Setter TargetName="Border" Property="Background" Value="#2A3037"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#1E2228"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#F28C28"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Foreground"
                        Value="White"/>
            </Trigger>

        </Style.Triggers>

    </Style>
    
    <Style x:Key="ForgeButtonStyle"
       TargetType="Button">

        <Setter Property="Foreground" Value="#E5E7EB"/>

        <Setter Property="Background" Value="#2B2D31"/>

        <Setter Property="BorderBrush" Value="#3A4048"/>

        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="Padding" Value="14,8"/>

        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="FontWeight" Value="SemiBold"/>

        <Setter Property="FontSize" Value="13"/>

        <Setter Property="MinHeight" Value="34"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">

                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="#F28C28"/>

                            <Setter TargetName="Border"
                                Property="Background"
                                Value="#31353B"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                             Value="True">

                            <Setter TargetName="Border"
                                Property="Background"
                                Value="#1E2126"/>

                            <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="#FF9A2F"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>