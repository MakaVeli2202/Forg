<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#1E1E1E</Color>
    <Color x:Key="SidebarColor">#252526</Color>
    <Color x:Key="CardColor">#2D2D30</Color>
    <Color x:Key="AccentColor">#FF7A00</Color>

    <SolidColorBrush x:Key="BackgroundBrush"
                     Color="{StaticResource BackgroundColor}"/>

    <SolidColorBrush x:Key="SidebarBrush"
                     Color="{StaticResource SidebarColor}"/>

    <SolidColorBrush x:Key="CardBrush"
                     Color="{StaticResource CardColor}"/>

    <SolidColorBrush x:Key="AccentBrush"
                     Color="{StaticResource AccentColor}"/>

</ResourceDictionary>