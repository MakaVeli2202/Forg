<UserControl x:Class="Forge.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- About -->

        <Border Grid.Row="0"
                Background="#1C130C"
                BorderBrush="#33FF7A00"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22,18"
                Margin="4,0,0,14">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="&#x1F525;"
                           FontSize="40"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF7A00"
                                          BlurRadius="25"
                                          ShadowDepth="0"
                                          Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="FORGE"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FFF3E8"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0">

                        <TextBlock x:Name="VersionText"
                                   Text="Version 1.0.0"
                                   FontSize="12"
                                   Foreground="#B39B85"/>

                        <TextBlock x:Name="ElevationText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="16,0,0,0"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- Catalogs -->

        <Border Grid.Row="1"
                Background="#1C130C"
                BorderBrush="#33FF7A00"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22,18"
                Margin="4,0,0,14">

            <StackPanel>

                <TextBlock Text="CATALOGS"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8A7462"/>

                <TextBlock Text="Forge reads its app and tweak catalogs from JSON files - edit them to add your own entries."
                           FontSize="12.5"
                           Foreground="#B39B85"
                           Margin="0,6,0,14"/>

                <WrapPanel>

                    <Button Content="Open Config Folder"
                            Style="{StaticResource ForgeButtonStyle}"
                            Click="OpenConfig_Click"/>

                    <Button Content="Reload Catalogs"
                            Style="{StaticResource ForgeButtonStyle}"
                            Margin="10,0,0,0"
                            Click="ReloadCatalogs_Click"/>

                </WrapPanel>

            </StackPanel>

        </Border>

        <!-- Behaviour -->

        <Border Grid.Row="2"
                Background="#1C130C"
                BorderBrush="#33FF7A00"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22,18"
                Margin="4,0,0,0">

            <StackPanel>

                <TextBlock Text="BEHAVIOUR"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8A7462"/>

                <CheckBox x:Name="StartupCheck"
                          Content="Start Forge with Windows (current user)"
                          Foreground="#FFF3E8"
                          FontSize="13"
                          Margin="0,12,0,0"
                          Checked="Startup_Changed"
                          Unchecked="Startup_Changed"/>

                <TextBlock Text="Forge always runs elevated; the dark forge theme is baked in."
                           FontSize="11.5"
                           Foreground="#8A7462"
                           Margin="0,10,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
