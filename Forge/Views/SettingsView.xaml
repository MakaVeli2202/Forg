<UserControl x:Class="Forge.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <StackPanel>

            <TextBlock Text="Settings"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <CheckBox Content="Start Forge with Windows"
                      Foreground="White"
                      Margin="0,20,0,0"/>

            <CheckBox Content="Check for Updates on Startup"
                      Foreground="White"/>

            <CheckBox Content="Enable Dark Theme"
                      Foreground="White"/>

        </StackPanel>

    </Grid>

</UserControl>