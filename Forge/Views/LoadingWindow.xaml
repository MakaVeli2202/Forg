<Window x:Class="Forge.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Height="240"
        Width="420"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#33FF7A00"
            BorderThickness="1"
            CornerRadius="18"
            Background="#171009">

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="&#x1F525;"
                       FontSize="42"
                       HorizontalAlignment="Center"
                       Name="FireGlyph">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF7A00"
                                      BlurRadius="30"
                                      ShadowDepth="0"
                                      Opacity="0.6"/>
                </TextBlock.Effect>
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="TextBlock.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="FireGlyph"
                                                 Storyboard.TargetProperty="(TextBlock.Effect).(DropShadowEffect.Opacity)"
                                                 From="0.4" To="0.9"
                                                 Duration="0:0:1.2"
                                                 AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <TextBlock Text="FORGE"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#FFF3E8"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF7A00"
                                      BlurRadius="14"
                                      ShadowDepth="0"
                                      Opacity="0.35"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="Stoking the forge - scanning installed apps..."
                       Margin="0,12,0,18"
                       Foreground="#B39B85"
                       FontSize="13"
                       HorizontalAlignment="Center"/>

            <ProgressBar IsIndeterminate="True"
                         Width="280"
                         Height="4"
                         BorderThickness="0"
                         Background="#241709"
                         Foreground="#FF7A00"/>

        </StackPanel>

    </Border>

</Window>
