<Window x:Class="Forge.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Height="220"
        Width="400"
        Background="#202020"
        ShowInTaskbar="False">

    <Border BorderBrush="#404040"
            BorderThickness="1"
            CornerRadius="10">

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="Forge"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Scanning installed applications..."
                       Margin="0,20,0,20"
                       Foreground="#CCCCCC"
                       FontSize="14"
                       HorizontalAlignment="Center"/>

            <ProgressBar IsIndeterminate="True"
                         Width="250"
                         Height="18"/>

        </StackPanel>

    </Border>

</Window>