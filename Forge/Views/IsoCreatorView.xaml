<UserControl x:Class="Forge.Views.IsoCreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Source card -->

        <Border Grid.Row="0"
                Background="#1C130C"
                BorderBrush="#33FF7A00"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22,18"
                Margin="4,0,0,14">

            <StackPanel>

                <TextBlock Text="STEP 1 - PICK A WINDOWS ISO"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8A7462"/>

                <TextBlock Text="Download a fresh ISO from Microsoft, or point Forge at one you already have."
                           FontSize="12.5"
                           Foreground="#B39B85"
                           Margin="0,6,0,16"/>

                <StackPanel Orientation="Horizontal">

                    <Button Content="Download Windows 11 ISO"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="DownloadIso_Click"/>

                    <Button Content="Browse for local ISO..."
                            Style="{StaticResource ForgeButtonStyle}"
                            Margin="12,0,0,0"
                            Click="BrowseIso_Click"/>

                </StackPanel>

                <TextBox x:Name="IsoPathBox"
                         Height="34"
                         Margin="0,16,0,0"
                         Background="#171009"
                         Foreground="#FFF3E8"
                         BorderBrush="#3D2C1D"
                         BorderThickness="1"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         FontSize="12.5"
                         IsReadOnly="True"/>

            </StackPanel>

        </Border>

        <!-- Build card -->

        <Border Grid.Row="1"
                Background="#1C130C"
                BorderBrush="#33FF7A00"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22,18"
                Margin="4,0,0,0">

            <StackPanel>

                <TextBlock Text="STEP 2 - FORGE THE IMAGE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8A7462"/>

                <TextBlock Text="Strip bloat, inject your tweak set and bake a clean install image."
                           FontSize="12.5"
                           Foreground="#B39B85"
                           Margin="0,6,0,14"/>

                <StackPanel Orientation="Horizontal">

                    <Button x:Name="BtnCreateIso"
                            Content="Create Custom ISO"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CreateIso_Click"/>

                    <TextBlock x:Name="IsoStatusText"
                               Text=""
                               FontSize="12"
                               Foreground="#FFB155"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- Pipeline info -->

        <Border Grid.Row="2"
                Background="#171009"
                BorderBrush="#3D2C1D"
                BorderThickness="1"
                CornerRadius="14"
                Margin="4,14,0,0"
                Padding="22,16">

            <StackPanel>

                <TextBlock Text="HOW IT WORKS"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8A7462"/>

                <TextBlock FontSize="12.5"
                           Foreground="#B39B85"
                           LineHeight="22"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="1. Mount the ISO and copy its contents to a working folder.&#x0a;2. Apply your Forge tweak set offline against the mounted image.&#x0a;3. Repack the image with oscdimg and burn or flash it with Rufus."/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
