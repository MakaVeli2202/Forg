<UserControl x:Class="Forge.Views.IsoCreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <StackPanel>

            <TextBlock Text="ISO Creator"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Select a Windows ISO"
                       Margin="0,20,0,10"
                       Foreground="White"/>

            <TextBox Height="30"
                     Width="500"/>

            <Button Content="Browse..."
                    Width="150"
                    Margin="0,10,0,0"/>

            <Button Content="Create Custom ISO"
                    Width="200"
                    Margin="0,20,0,0"/>

        </StackPanel>

    </Grid>

</UserControl>