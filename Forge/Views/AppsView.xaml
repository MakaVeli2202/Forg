<UserControl x:Class="Forge.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + Inline Stats -->

        <Grid Grid.Row="0"
              Margin="4,0,4,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                <TextBlock Text="Application Management"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Install, update and manage software packages."
                           Foreground="#9A9088"
                           Margin="0,1,0,0"
                           FontSize="10.5"/>

            </StackPanel>

            <UniformGrid x:Name="StatsSection"
                         Grid.Column="2"
                         Columns="4"
                         VerticalAlignment="Center">

                <Border Background="#252526"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="4,0,0,0"
                        Padding="12,5">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Total"
                                   Foreground="#6E6460"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="TotalAppsText"
                                   Text="0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <Border Background="#18251D"
                        BorderBrush="#2C8C5F"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="8,0,0,0"
                        Padding="12,5">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Installed"
                                   Foreground="#6FCF97"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="InstalledAppsText"
                                   Text="0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#6FCF97"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <Border Background="#1B2530"
                        BorderBrush="#3D5A78"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="8,0,0,0"
                        Padding="12,5">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Selected"
                                   Foreground="#5BC0EB"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="SelectedAppsText"
                                   Text="0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#5BC0EB"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

                <Border Background="#2D2D30"
                        BorderBrush="#6E5533"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="8,0,0,0"
                        Padding="12,5">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Recommended"
                                   Foreground="#FF7A00"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="RecommendedAppsText"
                                   Text="0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FF7A00"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </UniformGrid>

        </Grid>

        <!-- Search -->

        <Border x:Name="SearchSection"
                Grid.Row="1"
                Background="#252526"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6"
                Margin="0,0,0,8">

            <Grid>

                <TextBox x:Name="SearchBox"
                         Height="28"
                         FontSize="12"
                         Padding="34,0,10,0"
                         VerticalContentAlignment="Center"
                         Background="#1E1E1E"
                         Foreground="White"
                         BorderBrush="#3A3A3A"
                         BorderThickness="1"/>

                <TextBlock Text="&#x1F50D;  Search apps..."
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#9A9088"
                           FontSize="11"
                           IsHitTestVisible="False"/>

                <TextBlock x:Name="PlaceholderText"
                           Text="Search applications..."
                           Margin="34,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#6E6460"
                           FontSize="11"
                           IsHitTestVisible="False"/>

            </Grid>

        </Border>

        <!-- Category Chips -->

        <ScrollViewer x:Name="FiltersSection"
                      Grid.Row="2"
                      Margin="0,0,0,8"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled">

            <ListBox x:Name="CategoriesList"
                     SelectionChanged="CategoriesList_SelectionChanged"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectedIndex="0">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.Resources>

                    <Style TargetType="ListBoxItem">

                        <Setter Property="Margin" Value="0,0,5,5"/>
                        <Setter Property="Foreground" Value="White"/>

                        <Setter Property="Template">
                            <Setter.Value>

                                <ControlTemplate TargetType="ListBoxItem">

                                    <Border x:Name="Chip"
                                            Background="#252526"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,4">

                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsSelected"
                                                 Value="True">

                                            <Setter TargetName="Chip"
                                                    Property="Background"
                                                    Value="#FF7A00"/>

                                            <Setter TargetName="Chip"
                                                    Property="BorderBrush"
                                                    Value="#FF7A00"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Setter.Value>
                        </Setter>

                    </Style>

                </ListBox.Resources>

                <ListBoxItem Content="All"/>
                <ListBoxItem Content="Installed"/>
                <ListBoxItem Content="Not Installed"/>
                <ListBoxItem Content="Recommended"/>

                <ListBoxItem Content="Development"/>
                <ListBoxItem Content="Utilities"/>
                <ListBoxItem Content="Gaming"/>
                <ListBoxItem Content="AI"/>
                <ListBoxItem Content="Microsoft"/>
                <ListBoxItem Content="Multimedia"/>
                <ListBoxItem Content="Browsers"/>
                <ListBoxItem Content="Communications"/>
                <ListBoxItem Content="Document"/>
                <ListBoxItem Content="Pro Tools"/>
                <ListBoxItem Content="Benchmarks"/>

            </ListBox>

        </ScrollViewer>

        <!-- Selection Toolbar -->

        <StackPanel Grid.Row="3"
                    Margin="0,0,0,8">

            <DockPanel Margin="4,0,4,0">

                <TextBlock x:Name="AppsHeaderText"
                           Text="Apps (0)"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Margin="0,0,12,0"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">

                    <TextBlock Text="Sort:"
                               Foreground="#6E6460"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <ComboBox x:Name="SortComboBox"
                              Width="140"
                              Height="24"
                              FontSize="11"
                              Background="#252526"
                              Foreground="#E8E0D8"
                              BorderBrush="#2A2A2A"
                              BorderThickness="1"
                              SelectedIndex="0"
                              SelectionChanged="SortComboBox_SelectionChanged">

                        <ComboBoxItem Content="Name (A-Z)"/>
                        <ComboBoxItem Content="Name (Z-A)"/>
                        <ComboBoxItem Content="Category"/>
                        <ComboBoxItem Content="Publisher"/>
                        <ComboBoxItem Content="Installed First"/>
                        <ComboBoxItem Content="Recommended First"/>

                    </ComboBox>

                </StackPanel>

                <Border x:Name="SelectionSection"
                        Background="#252526"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right">

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="BtnSelectAll"
                                Content="Select All"
                                Style="{StaticResource ForgeButtonStyle}"
                                Background="#252526"
                                Height="26"
                                MinWidth="80"
                                FontSize="11"
                                Margin="0,0,6,0"
                                ToolTip="Select all applications in the current view"
                                Click="BtnSelectAll_Click"/>

                        <Button x:Name="BtnSelectRecommended"
                                Content="Recommended"
                                Style="{StaticResource ForgeButtonStyle}"
                                Background="#252526"
                                Height="26"
                                MinWidth="95"
                                FontSize="11"
                                Margin="0,0,6,0"
                                ToolTip="Select only recommended applications"
                                Click="BtnSelectRecommended_Click"/>

                        <Button x:Name="BtnClearSelection"
                                Content="Clear"
                                Style="{StaticResource ForgeButtonStyle}"
                                Background="#252526"
                                Height="26"
                                MinWidth="60"
                                FontSize="11"
                                ToolTip="Clear all selections"
                                Click="BtnClearSelection_Click"/>

                    </StackPanel>

                </Border>

            </DockPanel>

        </StackPanel>

        <!-- Applications Grid -->

        <Grid Grid.Row="4">

            <!-- Skeleton Loader -->
            <Border x:Name="SkeletonGrid"
                    Background="#1E1E1E"
                    CornerRadius="12"
                    Padding="2"
                    VerticalAlignment="Stretch">

                <Grid Margin="6">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Scanning installed apps..."
                               Foreground="#6E6460"
                               FontSize="12"
                               Margin="4,0,0,10"/>

                    <ItemsControl Grid.Row="1"
                                  Margin="2,0,0,0">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3"
                                        Padding="8,7"
                                        Width="168"
                                        MinHeight="82"
                                        Background="#252526"
                                        BorderBrush="#2A2A2A"
                                        BorderThickness="1"
                                        CornerRadius="9">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon placeholder -->
                                        <Border Width="32"
                                                Height="32"
                                                CornerRadius="8"
                                                Background="#2D2D30"/>

                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0,16,0"
                                                    VerticalAlignment="Top">

                                            <!-- Name bar -->
                                            <Border x:Name="NameBar"
                                                    Height="10"
                                                    CornerRadius="3"
                                                    Background="#2D2D30"
                                                    HorizontalAlignment="Left"
                                                    Width="90"/>

                                            <!-- Category bar -->
                                            <Border x:Name="CategoryBar"
                                                    Height="8"
                                                    CornerRadius="3"
                                                    Background="#2D2D30"
                                                    HorizontalAlignment="Left"
                                                    Width="60"
                                                    Margin="0,6,0,0"/>

                                            <!-- Status bar -->
                                            <Border x:Name="StatusBar"
                                                    Height="14"
                                                    CornerRadius="4"
                                                    Background="#2D2D30"
                                                    HorizontalAlignment="Left"
                                                    Width="50"
                                                    Margin="0,8,0,0"/>

                                        </StackPanel>
                                    </Grid>

                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard x:Name="PulseStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="NameBar"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="0.4" To="1.0"
                                                                     Duration="0:0:1.2"/>
                                                    <DoubleAnimation Storyboard.TargetName="CategoryBar"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="0.4" To="1.0"
                                                                     Duration="0:0:1.2"
                                                                     BeginTime="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="StatusBar"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="0.4" To="1.0"
                                                                     Duration="0:0:1.2"
                                                                     BeginTime="0:0:0.3"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <ItemsControl.ItemsSource>
                            <x:Array Type="{x:Type sys:Int32}">
                                <sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32><sys:Int32>3</sys:Int32><sys:Int32>4</sys:Int32>
                                <sys:Int32>5</sys:Int32><sys:Int32>6</sys:Int32><sys:Int32>7</sys:Int32><sys:Int32>8</sys:Int32>
                                <sys:Int32>9</sys:Int32><sys:Int32>10</sys:Int32><sys:Int32>11</sys:Int32><sys:Int32>12</sys:Int32>
                                <sys:Int32>13</sys:Int32><sys:Int32>14</sys:Int32><sys:Int32>15</sys:Int32><sys:Int32>16</sys:Int32>
                                <sys:Int32>17</sys:Int32><sys:Int32>18</sys:Int32><sys:Int32>19</sys:Int32><sys:Int32>20</sys:Int32>
                                <sys:Int32>21</sys:Int32><sys:Int32>22</sys:Int32><sys:Int32>23</sys:Int32><sys:Int32>24</sys:Int32>
                                <sys:Int32>25</sys:Int32><sys:Int32>26</sys:Int32><sys:Int32>27</sys:Int32><sys:Int32>28</sys:Int32>
                                <sys:Int32>29</sys:Int32><sys:Int32>30</sys:Int32><sys:Int32>31</sys:Int32><sys:Int32>32</sys:Int32>
                                <sys:Int32>33</sys:Int32><sys:Int32>34</sys:Int32><sys:Int32>35</sys:Int32><sys:Int32>36</sys:Int32>
                                <sys:Int32>37</sys:Int32><sys:Int32>38</sys:Int32><sys:Int32>39</sys:Int32><sys:Int32>40</sys:Int32>
                            </x:Array>
                        </ItemsControl.ItemsSource>

                    </ItemsControl>

                </Grid>

            </Border>

            <Border x:Name="AppsContent"
                    Background="#1E1E1E"
                    CornerRadius="12"
                    Padding="2"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed">

                <ScrollViewer Margin="6"
                              Background="Transparent"
                              BorderThickness="0"
                              VerticalAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="AppsList"
                                  Background="Transparent"
                                  BorderThickness="0">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Margin="3"
                                        Padding="8,7"
                                        Width="168"
                                        MinHeight="82"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="AppCard_MouseLeftButtonUp"
                                        ToolTipService.InitialShowDelay="250"
                                        ToolTipService.ShowDuration="20000">

                                    <Border.ToolTip>
                                        <StackPanel MaxWidth="270">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold"
                                                       FontSize="12.5"/>
                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Foreground="#9A9088"
                                                       FontSize="10.5"
                                                       Margin="0,5,0,0">
                                                <Run Text="{Binding Publisher, Mode=OneWay}"/>
                                                <Run Text="  -  "/>
                                                <Run Text="{Binding Category, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border.ToolTip>

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="5"
                                                          ShadowDepth="0"
                                                          Color="#000000"
                                                          Opacity="0.14"/>
                                    </Border.Effect>

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#252526"/>
                                            <Setter Property="BorderBrush" Value="#2A2A2A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="9"/>

                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2D2D30"/>
                                                    <Setter Property="BorderBrush" Value="#535B66"/>
                                                </Trigger>

                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#333333"/>
                                                    <Setter Property="BorderBrush" Value="#FF7A00"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                        <Condition Binding="{Binding IsInstalled}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#18251D"/>
                                                    <Setter Property="BorderBrush" Value="#2C8C5F"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="32"
                                                Height="32"
                                                CornerRadius="8"
                                                Background="#2D2D30"
                                                VerticalAlignment="Top">
                                            <Image Source="{Binding IconDisplay}"
                                                   Width="19"
                                                   Height="19"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0,16,0"
                                                    VerticalAlignment="Top">

                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="10.75"
                                                       LineHeight="13"
                                                       MaxHeight="26"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding Category}"
                                                       Margin="0,2,0,0"
                                                       Foreground="#6E6460"
                                                       FontSize="8.25"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <Border Padding="4,1"
                                                    CornerRadius="4"
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2A2A2A"/>
                                                        <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                                <Setter Property="Background" Value="#2C8C5F"/>
                                                                <Setter Property="BorderBrush" Value="#2C8C5F"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Installing">
                                                                <Setter Property="Background" Value="#B97917"/>
                                                                <Setter Property="BorderBrush" Value="#B97917"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Upgrading">
                                                                <Setter Property="Background" Value="#4A6DAA"/>
                                                                <Setter Property="BorderBrush" Value="#4A6DAA"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Uninstalling">
                                                                <Setter Property="Background" Value="#A14B3F"/>
                                                                <Setter Property="BorderBrush" Value="#A14B3F"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Background" Value="#B0504A"/>
                                                                <Setter Property="BorderBrush" Value="#B0504A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cancelling">
                                                                <Setter Property="Background" Value="#A14B3F"/>
                                                                <Setter Property="BorderBrush" Value="#A14B3F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="7.5"/>
                                            </Border>

                                        </StackPanel>

                                        <!-- Recommended marker -->
                                        <TextBlock Grid.ColumnSpan="2"
                                                   Text="&#x2605;"
                                                   Foreground="#FF7A00"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,3,26,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Recommended}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Selection check badge (top-right corner, mirrors icon inset) -->
                                        <Border Grid.ColumnSpan="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,0,0,0"
                                                Width="18"
                                                Height="18"
                                                CornerRadius="9"
                                                Background="#2D2D30"
                                                BorderBrush="#66FF7A00"
                                                BorderThickness="1"
                                                IsHitTestVisible="False">
                                            <Path Data="M 4 9 L 7.5 12.5 L 13 5.5"
                                                  Stroke="#FF7A00"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Border>

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">

                <TextBlock Text="No apps found"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Try adjusting your search or filters."
                           Foreground="#9A9088"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"/>

            </StackPanel>

        </Grid>

        <Popup x:Name="AppPreviewPopup"
               AllowsTransparency="True"
               Placement="MousePoint"
               StaysOpen="False"
               PopupAnimation="Fade">

            <Border Background="#1E1E1E"
                    x:Name="AppPreviewBorder"
                    CornerRadius="12"
                    Padding="14"
                    Width="340"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    Opacity="0.98">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="4"
                                      Color="#000000"
                                      Opacity="0.35"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Application Preview"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="White"/>

                    <TextBlock x:Name="PreviewAppName"
                               Margin="0,8,0,0"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="Hover an app card"/>

                    <TextBlock x:Name="PreviewAppCategory"
                               Foreground="#9A9088"
                               Margin="0,2,0,0"/>

                    <TextBlock x:Name="PreviewAppStatus"
                               Foreground="#5BC0EB"
                               Margin="0,2,0,0"/>

                    <TextBlock x:Name="PreviewAppDescription"
                               Margin="0,8,0,0"
                               Foreground="#C9CED6"
                               TextWrapping="Wrap"/>

                    <Border Background="#2D2D30"
                            CornerRadius="8"
                            Margin="0,10,0,0"
                            Padding="8,6">
                        <TextBlock x:Name="PreviewAppMeta"
                                   Foreground="#9A9088"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

            </Border>

        </Popup>

        <!-- Activity Log -->

        <Border x:Name="ActivitySection"
                Grid.Row="5"
                Background="#252526"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8,5"
                Margin="0,8,0,0">

            <Grid>

                <TextBlock Text="Activity"
                           Foreground="#6E6460"
                           FontWeight="SemiBold"
                           FontSize="10.5"
                           Margin="0,0,0,4"/>

                <TextBox x:Name="ActivityLog"
                         MaxHeight="56"
                         Margin="0,17,0,0"
                         Background="Transparent"
                         Foreground="#9A9088"
                         BorderThickness="0"
                         IsReadOnly="True"
                         FontSize="10.5"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>

            </Grid>

        </Border>

        <!-- Status -->

        <Border x:Name="StatusSection"
                Grid.Row="6"
                Background="#252526"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8,5"
                Margin="0,8,0,0">

            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Status: Ready"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="11"/>

                <ProgressBar x:Name="InstallProgressBar"
                             Height="8"
                             Margin="0,4,0,0"
                             Minimum="0"
                             Maximum="100"
                             Visibility="Collapsed"/>

            </StackPanel>

        </Border>

        <!-- Action Buttons -->

        <Border x:Name="ActionsSection"
                Grid.Row="7"
                Background="#252526"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8,5"
                Margin="0,8,0,0">

            <WrapPanel HorizontalAlignment="Right">

                <Button x:Name="BtnInstall"
                        Style="{StaticResource ForgeButtonStyle}"
                        Background="#FF7A00"
                        Content="Install Selected"
                        Height="30"
                        MinWidth="130"
                        FontSize="11.5"
                        Margin="0,0,6,0"
                        ToolTip="Install all selected applications"
                        Click="BtnInstall_Click"/>

                <Button x:Name="BtnUpgrade"
                        Style="{StaticResource ForgeButtonStyle}"
                        Background="#0078D4"
                        Content="Upgrade"
                        Height="30"
                        MinWidth="90"
                        FontSize="11.5"
                        Margin="0,0,6,0"
                        ToolTip="Upgrade selected installed applications"
                        Click="BtnUpgrade_Click"/>

                <Button x:Name="BtnDetectInstalled"
                        Style="{StaticResource ForgeButtonStyle}"
                        Background="#3A3A3A"
                        Content="Detect Installed"
                        Height="30"
                        MinWidth="115"
                        FontSize="11.5"
                        Margin="0,0,6,0"
                        ToolTip="Scan system for installed applications"
                        Click="BtnDetectInstalled_Click"/>

                <Button x:Name="BtnUninstall"
                        Style="{StaticResource ForgeButtonStyle}"
                        Background="#D13438"
                        Content="Uninstall"
                        Height="30"
                        MinWidth="90"
                        FontSize="11.5"
                        Margin="0,0,6,0"
                        ToolTip="Remove selected installed applications"
                        Click="BtnUninstall_Click"/>

                <Button x:Name="BtnCancel"
                        Style="{StaticResource ForgeButtonStyle}"
                        Background="#666666"
                        Content="Cancel"
                        Height="30"
                        MinWidth="80"
                        FontSize="11.5"
                        IsEnabled="False"
                        ToolTip="Cancel the current operation"
                        Click="BtnCancel_Click"/>

            </WrapPanel>

        </Border>

    </Grid>

</UserControl>
