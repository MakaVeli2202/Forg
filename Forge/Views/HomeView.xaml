<UserControl
    x:Class="Forge.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HERO -->

        <Border Grid.Row="0"
                Background="#1C130C"
                BorderBrush="#33FF7A00"
                BorderThickness="1"
                CornerRadius="18"
                Padding="28,24">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="THE WORKSHOP FOR YOUR PC"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#8A7462"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Forge your Windows."
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FFF3E8">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF7A00"
                                              BlurRadius="16"
                                              ShadowDepth="0"
                                              Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,14,0,0">

                        <TextBlock x:Name="StatAppsText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB155"/>

                        <TextBlock x:Name="StatTweaksText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#7FAE96"
                                   Margin="18,0,0,0"/>

                    </StackPanel>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="&#x1F525;"
                           FontSize="72"
                           Margin="30,0,10,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF7A00"
                                          BlurRadius="40"
                                          ShadowDepth="0"
                                          Opacity="0.55"/>
                    </TextBlock.Effect>
                </TextBlock>

            </Grid>

        </Border>

        <!-- RECOMMENDED CONTENT -->

        <Grid Grid.Row="1"
              Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Recommended apps -->

            <Border Grid.Column="0"
                    Background="#1C130C"
                    BorderBrush="#3D2C1D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,10">

                        <TextBlock Text="RECOMMENDED APPS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A7462"/>

                        <TextBlock x:Name="RecommendedSummaryText"
                                   FontSize="12.5"
                                   Foreground="#B39B85"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                    <ItemsControl x:Name="RecommendedAppsList"
                                  Grid.Row="1"
                                  Margin="2,0,0,6">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,5">

                                    <Border Width="24"
                                            Height="24"
                                            CornerRadius="6"
                                            Background="#241709">
                                        <Image Source="{Binding IconDisplay}"
                                               Width="16"
                                               Height="16"/>
                                    </Border>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#FFF3E8"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>

                                    <TextBlock Text="installed"
                                               FontSize="10.5"
                                               Foreground="#22C55E"
                                               VerticalAlignment="Center"
                                               Margin="8,1,0,0"
                                               Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <Button Grid.Row="2"
                            Content="Open App Manager"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Click="RecommendedApps_Click"/>

                </Grid>

            </Border>

            <!-- Essential tweaks -->

            <Border Grid.Column="2"
                    Background="#1C130C"
                    BorderBrush="#3D2C1D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,10">

                        <TextBlock Text="ESSENTIAL TWEAKS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A7462"/>

                        <TextBlock x:Name="EssentialSummaryText"
                                   FontSize="12.5"
                                   Foreground="#B39B85"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                    <ItemsControl x:Name="EssentialTweaksList"
                                  Grid.Row="1"
                                  Margin="2,0,0,6">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,5">

                                    <TextBlock Text="&#x26A1;"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#FFF3E8"
                                               VerticalAlignment="Center"
                                               Margin="9,0,0,0"/>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <Button Grid.Row="2"
                            Content="Open Tweaks"
                            Style="{StaticResource ForgeButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Click="EssentialTweaks_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>
