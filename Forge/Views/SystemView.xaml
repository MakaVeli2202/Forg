<UserControl x:Class="Forge.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="4,0,0,16">

            <TextBlock Text="ADMIN TOOLS, ONE CLICK AWAY"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#6E6460"/>

            <TextBlock Text="Every tool opens elevated, because Forge already runs as administrator."
                       FontSize="13"
                       Foreground="#9A9088"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <WrapPanel>

                <Button Style="{StaticResource ForgeButtonStyle}"
                        Width="300" Margin="0,0,12,12"
                        HorizontalContentAlignment="Left" Padding="16,12"
                        Click="OpenTool_Click" Tag="devmgmt.msc">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="24" Margin="0,0,14,0" Text="&#x1F5A5;"/>
                        <StackPanel>
                            <TextBlock Text="Device Manager" FontWeight="SemiBold" Foreground="#E8E0D8"/>
                            <TextBlock Text="Hardware and drivers" FontSize="11" Foreground="#9A9088"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ForgeButtonStyle}"
                        Width="300" Margin="0,0,12,12"
                        HorizontalContentAlignment="Left" Padding="16,12"
                        Click="OpenTool_Click" Tag="services.msc">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="24" Margin="0,0,14,0" Text="&#x2699;"/>
                        <StackPanel>
                            <TextBlock Text="Services" FontWeight="SemiBold" Foreground="#E8E0D8"/>
                            <TextBlock Text="Windows service control" FontSize="11" Foreground="#9A9088"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ForgeButtonStyle}"
                        Width="300" Margin="0,0,0,12"
                        HorizontalContentAlignment="Left" Padding="16,12"
                        Click="OpenTool_Click" Tag="regedit">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="24" Margin="0,0,14,0" Text="&#x1F9BE;"/>
                        <StackPanel>
                            <TextBlock Text="Registry Editor" FontWeight="SemiBold" Foreground="#E8E0D8"/>
                            <TextBlock Text="Edit the Windows registry" FontSize="11" Foreground="#9A9088"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ForgeButtonStyle}"
                        Width="300" Margin="0,12,12,0"
                        HorizontalContentAlignment="Left" Padding="16,12"
                        Click="OpenTool_Click" Tag="taskschd.msc">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="24" Margin="0,0,14,0" Text="&#x23F0;"/>
                        <StackPanel>
                            <TextBlock Text="Task Scheduler" FontWeight="SemiBold" Foreground="#E8E0D8"/>
                            <TextBlock Text="Scheduled tasks and jobs" FontSize="11" Foreground="#9A9088"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ForgeButtonStyle}"
                        Width="300" Margin="0,12,12,0"
                        HorizontalContentAlignment="Left" Padding="16,12"
                        Click="OpenTool_Click" Tag="eventvwr.msc">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="24" Margin="0,0,14,0" Text="&#x1F4DC;"/>
                        <StackPanel>
                            <TextBlock Text="Event Viewer" FontWeight="SemiBold" Foreground="#E8E0D8"/>
                            <TextBlock Text="System and app logs" FontSize="11" Foreground="#9A9088"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ForgeButtonStyle}"
                        Width="300" Margin="0,12,0,0"
                        HorizontalContentAlignment="Left" Padding="16,12"
                        Click="OpenTool_Click" Tag="control">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="24" Margin="0,0,14,0" Text="&#x1F39B;"/>
                        <StackPanel>
                            <TextBlock Text="Control Panel" FontWeight="SemiBold" Foreground="#E8E0D8"/>
                            <TextBlock Text="Classic settings home" FontSize="11" Foreground="#9A9088"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

            </WrapPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
