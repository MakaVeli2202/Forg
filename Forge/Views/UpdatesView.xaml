<UserControl x:Class="Forge.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <StackPanel>

            <TextBlock Text="Updates"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <CheckBox Content="Windows Updates"
                      Foreground="White"
                      Margin="0,20,0,0"/>

            <CheckBox Content="Winget Updates"
                      Foreground="White"/>

            <CheckBox Content="Driver Updates"
                      Foreground="White"/>

            <Button Content="Check for Updates"
                    Width="220"
                    Margin="0,20,0,0"/>

            <Button Content="Update All"
                    Width="220"
                    Margin="0,10,0,0"/>

        </StackPanel>

    </Grid>

</UserControl>