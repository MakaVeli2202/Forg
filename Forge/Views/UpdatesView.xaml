<UserControl x:Class="Forge.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Action cards -->

        <WrapPanel Grid.Row="0"
                   Margin="4,0,0,14">

            <Border Background="#252526"
                    BorderBrush="#8CFF7A00"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,16"
                    Width="380"
                    Margin="0,0,12,0">

                <StackPanel>

                    <TextBlock Text="WINDOWS UPDATE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#6E6460"/>

                    <TextBlock Text="Security patches, drivers and quality updates from Microsoft."
                               FontSize="12"
                               Foreground="#9A9088"
                               Margin="0,6,0,14"
                               TextWrapping="Wrap"/>

                    <Button Content="Open Windows Update"
                            Style="{StaticResource ForgeButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="WindowsUpdate_Click"/>

                </StackPanel>

            </Border>

            <Border Background="#252526"
                    BorderBrush="#8CFF7A00"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,16"
                    Width="380">

                <StackPanel>

                    <TextBlock Text="APP UPDATES - WINGET"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#6E6460"/>

                    <TextBlock Text="Scan every installed program for a newer version."
                               FontSize="12"
                               Foreground="#9A9088"
                               Margin="0,6,0,14"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="BtnCheckUpdates"
                                Content="Check for Updates"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="CheckUpdates_Click"/>

                        <Button x:Name="BtnUpdateAll"
                                Content="Upgrade All"
                                Style="{StaticResource ForgeButtonStyle}"
                                IsEnabled="False"
                                Margin="10,0,0,0"
                                Click="UpdateAll_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </WrapPanel>

        <!-- Results -->

        <Border Grid.Row="1"
                Background="#1E1E1E"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="14"
                Margin="4,0,0,0">

            <Grid Margin="14">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Row="0"
                           Text="Ready. Click Check for Updates to scan installed apps."
                           FontSize="12"
                           Foreground="#9A9088"
                           Margin="6,2,0,8"/>

                <StackPanel Grid.Row="1"
                            Margin="6,0,6,10">

                    <ProgressBar x:Name="OpProgress"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 IsIndeterminate="False"
                                 Foreground="#FF7A00"
                                 Background="#2D2D30"
                                 BorderThickness="0"
                                 Visibility="Collapsed"/>

                    <Border x:Name="ActivityBorder"
                            CornerRadius="8"
                            Background="#1A1A1E"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <ListBox x:Name="ActivityLog"
                                 MaxHeight="130"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8,4"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 Foreground="#9A9088"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </Border>

                </StackPanel>

                <ListBox x:Name="OutdatedList"
                         Grid.Row="2"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#E8E0D8"
                         FontFamily="Consolas"
                         FontSize="12.5"
                         Visibility="Collapsed"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
