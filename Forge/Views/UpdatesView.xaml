<UserControl x:Class="Forge.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Action cards -->

        <WrapPanel Grid.Row="0"
                   Margin="4,0,0,14">

            <Border Background="#1C130C"
                    BorderBrush="#33FF7A00"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,16"
                    Width="380"
                    Margin="0,0,12,0">

                <StackPanel>

                    <TextBlock Text="WINDOWS UPDATE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#8A7462"/>

                    <TextBlock Text="Security patches, drivers and quality updates from Microsoft."
                               FontSize="12"
                               Foreground="#B39B85"
                               Margin="0,6,0,14"
                               TextWrapping="Wrap"/>

                    <Button Content="Open Windows Update"
                            Style="{StaticResource ForgeButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="WindowsUpdate_Click"/>

                </StackPanel>

            </Border>

            <Border Background="#1C130C"
                    BorderBrush="#33FF7A00"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,16"
                    Width="380">

                <StackPanel>

                    <TextBlock Text="APP UPDATES - WINGET"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#8A7462"/>

                    <TextBlock Text="Scan every installed program for a newer version."
                               FontSize="12"
                               Foreground="#B39B85"
                               Margin="0,6,0,14"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="BtnCheckUpdates"
                                Content="Check for Updates"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="CheckUpdates_Click"/>

                        <Button x:Name="BtnUpdateAll"
                                Content="Upgrade All"
                                Style="{StaticResource ForgeButtonStyle}"
                                IsEnabled="False"
                                Margin="10,0,0,0"
                                Click="UpdateAll_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </WrapPanel>

        <!-- Results -->

        <Border Grid.Row="1"
                Background="#171009"
                BorderBrush="#3D2C1D"
                BorderThickness="1"
                CornerRadius="14"
                Margin="4,0,0,0">

            <Grid Margin="14">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Row="0"
                           Text="Ready. Click Check for Updates to scan installed apps."
                           FontSize="12"
                           Foreground="#B39B85"
                           Margin="6,2,0,10"/>

                <ListBox x:Name="OutdatedList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FFF3E8"
                         FontFamily="Consolas"
                         FontSize="12.5"
                         Visibility="Collapsed"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
