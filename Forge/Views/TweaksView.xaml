<UserControl x:Class="Forge.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0"
                    Margin="2,0,0,10">

            <TextBlock Text="Tweaks &amp; Performance"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="White"/>

            <TextBlock Text="One click to apply, one click to undo. Hover any tweak for details."
                       Foreground="#9A9088"
                       Margin="0,2,0,0"
                       FontSize="11"/>

        </StackPanel>

        <!-- Toolbar -->

        <Border Grid.Row="1"
                Background="#252526"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8"
                Margin="0,0,0,10">

            <DockPanel LastChildFill="False">

                <Grid DockPanel.Dock="Left"
                      Width="240">

                    <TextBox x:Name="SearchBox"
                             Height="30"
                             FontSize="12"
                             Padding="28,0,8,0"
                             VerticalContentAlignment="Center"
                             Background="#1E1E1E"
                             Foreground="White"
                             BorderBrush="#3A3A3A"
                             BorderThickness="1"/>

                    <TextBlock Text="&#x1F50D;"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#9A9088"
                               IsHitTestVisible="False"/>

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Search tweaks..."
                               Margin="28,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#6E6460"
                               FontSize="11"
                               IsHitTestVisible="False"/>

                </Grid>

                <ListBox x:Name="GroupFilterList"
                         DockPanel.Dock="Left"
                         Margin="10,0,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectedIndex="0"
                         SelectionChanged="GroupFilterList_SelectionChanged">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="PillBorder"
                                                Background="#252526"
                                                BorderBrush="#2A2A2A"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12,5"
                                                Margin="0,0,6,0"
                                                Cursor="Hand">
                                            <ContentPresenter x:Name="PillText"
                                                              TextElement.Foreground="#E8E0D8"
                                                              TextElement.FontSize="11.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PillBorder" Property="Background" Value="#333333"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="PillBorder" Property="Background" Value="#FF7A00"/>
                                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#FF9A2F"/>
                                                <Setter TargetName="PillText" Property="TextElement.Foreground" Value="#1A0F05"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <ListBoxItem Content="All" Tag=""/>
                    <ListBoxItem Content="&#x1F680; Boost Performance" Tag="Boost Performance"/>
                    <ListBoxItem Content="&#x1F512; Better Privacy" Tag="Better Privacy"/>
                    <ListBoxItem Content="&#x1F9F9; Debloat &amp; Cleanup" Tag="Debloat &amp; Cleanup"/>
                    <ListBoxItem Content="&#x1F3A8; Customize &amp; Gaming" Tag="Customize &amp; Gaming"/>
                    <ListBoxItem Content="&#x1F310; Network" Tag="Network &amp; Connectivity"/>
                    <ListBoxItem Content="&#x2699;&#xFE0F; System &amp; Advanced" Tag="System &amp; Advanced"/>

                </ListBox>

            </DockPanel>

        </Border>

        <!-- Tweak list -->

        <Border Grid.Row="2"
                Background="#1E1E1E"
                CornerRadius="12"
                VerticalAlignment="Stretch">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="6">

                <ItemsControl x:Name="TweaksList">

                    <ItemsControl.GroupStyle>

                        <GroupStyle>

                            <GroupStyle.HeaderTemplate>

                                <DataTemplate>

                                    <Border Margin="2,10,2,6">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF7A00"/>

                                            <TextBlock Text="{Binding ItemCount, StringFormat={}({0})}"
                                                       FontSize="11"
                                                       Foreground="#6E6460"
                                                       Margin="8,4,0,0"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </GroupStyle.HeaderTemplate>

                        </GroupStyle>

                    </ItemsControl.GroupStyle>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border x:Name="TweakRow"
                                    Background="#252526"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    Margin="2,3"
                                    ToolTipService.InitialShowDelay="200"
                                    ToolTipService.ShowDuration="20000">

                                <Border.ToolTip>
                                    <StackPanel MaxWidth="300">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold"
                                                   FontSize="12.5"/>
                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Foreground="#9A9088"
                                                   FontSize="10.5"
                                                   Margin="0,5,0,0"
                                                   Text="{Binding Group}"/>
                                    </StackPanel>
                                </Border.ToolTip>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: name + badges + description -->
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,2">

                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#E8E0D8"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>

                                            <Border x:Name="CautionBadge"
                                                    Background="#3D1A1C"
                                                    BorderBrush="#B0504A"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="CAUTION"
                                                           FontSize="8"
                                                           FontWeight="Bold"
                                                           Foreground="#E08A85"/>
                                            </Border>

                                            <Border x:Name="AppliedBadge"
                                                    Background="#18251D"
                                                    BorderBrush="#2C8C5F"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateDisplay}"
                                                           FontSize="8"
                                                           FontWeight="SemiBold"
                                                           Foreground="#6FCF97"/>
                                            </Border>

                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#9A9088"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="900"
                                                   HorizontalAlignment="Left"/>

                                    </StackPanel>

                                    <!-- Right: action controls -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0"
                                                Orientation="Horizontal">

                                        <ComboBox x:Name="ComboSelector"
                                                  MinWidth="190"
                                                  Height="30"
                                                  FontSize="11.5"
                                                  ItemsSource="{Binding ComboItems}"
                                                  Visibility="{Binding IsCombobox, Converter={StaticResource BoolToVis}}"
                                                  Tag="{Binding}"
                                                  Loaded="ComboSelector_Loaded"
                                                  SelectionChanged="ComboSelector_SelectionChanged"/>

                                        <Button Content="Run"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Width="100"
                                                Height="30"
                                                FontSize="11.5"
                                                Visibility="{Binding IsButton, Converter={StaticResource BoolToVis}}"
                                                Tag="{Binding}"
                                                Click="RunTweakButton_Click"/>

                                        <Button x:Name="ApplyToggle"
                                                Content="Apply"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Width="100"
                                                Height="30"
                                                FontSize="11.5"
                                                Tag="{Binding}"
                                                Loaded="ApplyToggle_Loaded"
                                                Click="ApplyToggle_Click"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <DataTemplate.Triggers>

                                <DataTrigger Binding="{Binding Category}" Value="Advanced Tweaks">
                                    <Setter TargetName="CautionBadge" Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <Trigger SourceName="TweakRow" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TweakRow" Property="Background" Value="#2D2D30"/>
                                    <Setter TargetName="TweakRow" Property="BorderBrush" Value="#3D3D3D"/>
                                </Trigger>

                                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                    <Setter TargetName="ApplyToggle" Property="Content" Value="Undo"/>
                                    <Setter TargetName="ApplyToggle" Property="Background" Value="#0078D4"/>
                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Border>

        <!-- Footer log -->

        <Border Grid.Row="3"
                Background="#1E1E1E"
                CornerRadius="10"
                Padding="8"
                Margin="0,10,0,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">

                    <Button x:Name="BtnCancel"
                            Content="Cancel"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ForgeButtonStyle}"
                            Background="#666666"
                            Width="80"
                            Height="24"
                            FontSize="10"
                            Click="BtnCancel_Click"/>

                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                </DockPanel>

                <TextBox x:Name="ActivityLog"
                         Grid.Row="1"
                         MaxHeight="110"
                         Margin="0,6,0,0"
                         Background="Transparent"
                         Foreground="#9A9088"
                         BorderThickness="0"
                         IsReadOnly="True"
                         FontSize="11"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
