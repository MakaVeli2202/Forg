<Window x:Class="Forge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Forge"
        Width="1700"
        Height="1000"
        MinWidth="1400"
        MinHeight="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="14"
            Background="#0F0B08"
            BorderBrush="#33FF7A00"
            BorderThickness="1"
            ClipToBounds="True">

        <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TITLE BAR -->

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#161009"
                CornerRadius="14,14,0,0"
                BorderThickness="0,0,0,1"
                BorderBrush="#33FF7A00"
                SnapsToDevicePixels="True"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>

                <!-- Branding -->

                <StackPanel Orientation="Horizontal"
                            Margin="12,0"
                            VerticalAlignment="Center">

                    <Image Source="/Assets/Images/forge-logo.png"
                           Width="18"
                           Height="18"
                           Margin="0,0,8,0">

                        <Image.Effect>

                            <DropShadowEffect Color="#FF7A00"
                                              BlurRadius="15"
                                              ShadowDepth="0"
                                              Opacity="0.7"/>

                        </Image.Effect>

                    </Image>

                    <TextBlock Text="F"
                               Foreground="{StaticResource BrandEmberBrush}"
                               FontWeight="Bold"
                               FontSize="16">

                        <TextBlock.Effect>

                            <DropShadowEffect Color="#FF7A00"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.9"/>

                        </TextBlock.Effect>

                    </TextBlock>

                    <TextBlock Text="ORGE"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               FontSize="16"/>

                </StackPanel>

                                <Menu Grid.Column="1"
                                            Background="Transparent"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            FontSize="12">

                                        <MenuItem Header="View">
                                                <MenuItem Header="Counters"
                                                                    IsCheckable="True"
                                                                    IsChecked="True"
                                                                    Checked="ViewCounters_Checked"
                                                                    Unchecked="ViewCounters_Checked"/>

                                                <MenuItem Header="Search"
                                                                    IsCheckable="True"
                                                                    IsChecked="True"
                                                                    Checked="ViewSearch_Checked"
                                                                    Unchecked="ViewSearch_Checked"/>

                                                <MenuItem Header="Filters"
                                                                    IsCheckable="True"
                                                                    IsChecked="True"
                                                                    Checked="ViewFilters_Checked"
                                                                    Unchecked="ViewFilters_Checked"/>

                                                <Separator/>

                                                <MenuItem Header="Selection Toolbar"
                                                                    IsCheckable="True"
                                                                    IsChecked="True"
                                                                    Checked="ViewSelection_Checked"
                                                                    Unchecked="ViewSelection_Checked"/>

                                                <MenuItem Header="Activity Log"
                                                                    IsCheckable="True"
                                                                    IsChecked="True"
                                                                    Checked="ViewActivity_Checked"
                                                                    Unchecked="ViewActivity_Checked"/>

                                                <MenuItem Header="Status"
                                                                    IsCheckable="True"
                                                                    IsChecked="True"
                                                                    Checked="ViewStatus_Checked"
                                                                    Unchecked="ViewStatus_Checked"/>

                                                <MenuItem Header="Actions"
                                                                    IsCheckable="True"
                                                                    IsChecked="True"
                                                                    Checked="ViewActions_Checked"
                                                                    Unchecked="ViewActions_Checked"/>
                                        </MenuItem>

                                </Menu>

                <!-- Window Buttons -->

                                <Button Grid.Column="2"
                        Content="&#x2014;"
                        Style="{StaticResource TitleBarButtonStyle}"
                        FontSize="14"
                        Click="Minimize_Click"/>

                <Button Grid.Column="3"
                        Content="&#x25A1;"
                        Style="{StaticResource TitleBarButtonStyle}"
                        FontSize="12"
                        Click="Maximize_Click"/>

                <Button Grid.Column="4"
                        Content="&#x2715;"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Foreground="#F43F5E"
                        Click="Close_Click"/>

            </Grid>

        </Border>

        <!-- SIDEBAR -->

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#161009"
                CornerRadius="0,0,0,14">

            <Border.Effect>

                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="0"
                                  Color="#000000"
                                  Opacity="0.45"/>

            </Border.Effect>

            <StackPanel>

                <!-- Logo -->

                <Border Height="145"
                        Background="#1E140C"
                        CornerRadius="0,0,14,14"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#33FF7A00">

                    <StackPanel HorizontalAlignment="Center">

                        <Image Source="/Assets/Images/forge-logo.png"
                               Width="80"
                               Height="80"
                               Margin="0,10,0,5">

                            <Image.Effect>

                                <DropShadowEffect Color="#FF7A00"
                                                  BlurRadius="35"
                                                  ShadowDepth="0"
                                                  Opacity="0.9"/>

                            </Image.Effect>

                        </Image>

                        <TextBlock Text="FORGE"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center">

                            <TextBlock.Effect>

                                <DropShadowEffect Color="#FF7A00"
                                                  BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.35"/>

                            </TextBlock.Effect>

                        </TextBlock>

                        <TextBlock Text="BUILD WINDOWS YOUR WAY"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Navigation -->

                <StackPanel Margin="10">

                    <Button x:Name="BtnHome"
                            Style="{StaticResource NavButtonStyle}"
                            Content="&#x1F3E0; Home"
                            Click="BtnHome_Click"/>

                    <Button x:Name="BtnApps"
                            Style="{StaticResource NavButtonStyle}"
                            Content="&#x1F4E6; Apps"
                            Click="BtnApps_Click"/>

                    <Button x:Name="BtnTweaks"
                            Style="{StaticResource NavButtonStyle}"
                            Content="&#x1F527; Tweaks"
                            Click="BtnTweaks_Click"/>

                    <Button x:Name="BtnSystem"
                            Style="{StaticResource NavButtonStyle}"
                            Content="&#x1F5A5;&#xFE0F; System"
                            Click="BtnSystem_Click"/>

                    <Button x:Name="BtnUpdates"
                            Style="{StaticResource NavButtonStyle}"
                            Content="&#x1F504; Updates"
                            Click="BtnUpdates_Click"/>

                    <Button x:Name="BtnDrivers"
                            Style="{StaticResource NavButtonStyle}"
                            Content="&#x1F50C; Drivers"
                            Click="BtnDrivers_Click"/>

                    <Button x:Name="BtnIso"
                            Style="{StaticResource NavButtonStyle}"
                            Content="&#x1F4BF; ISO Creator"
                            Click="BtnIso_Click"/>

                    <Button x:Name="BtnSettings"
                            Style="{StaticResource NavButtonStyle}"
                            Content="&#x2699;&#xFE0F; Settings"
                            Click="BtnSettings_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- MAIN AREA -->

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <Border Grid.Row="0"
                    Background="#120D09"
                    CornerRadius="12,12,0,0">

                <Grid Margin="20,0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Rectangle Width="4"
                                   Height="22"
                                   RadiusX="2"
                                   RadiusY="2"
                                   Fill="{StaticResource FireGradientBrush}"
                                   Margin="0,0,10,0"/>

                        <TextBlock x:Name="PageTitle"
                                   Text="Home"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Content -->

            <Border Grid.Row="1"
                    Background="#120D09">

                <ContentControl x:Name="MainContent"/>

            </Border>

            <!-- Footer -->

            <Border Grid.Row="2"
                    Background="#120D09"
                    CornerRadius="0,0,12,12">

                <DockPanel Margin="15,0">

                    <TextBlock Text="Ready"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                </DockPanel>

            </Border>

        </Grid>

        </Grid>

    </Border>

</Window>
